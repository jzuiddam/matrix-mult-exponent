  unfold releasedL2RetainedNodeBlock22_2
  norm_num [releasedLevel2Data22, ReleasedLevel2TermData.toTerm, Term.retained,
    retainedStandard, entropyMu, rotate]
  all_goals simp at *
  all_goals ring

set_option maxHeartbeats 1000000 in
-- Exact normalization over at most 100 released nodes.
theorem releasedL2MatrixNodeBlock22_2_exact :
    (releasedLevel2Data22.map (fun data => data.toTerm.matrix 5 2)).sum = releasedL2MatrixNodeBlock22_2 := by
  unfold releasedL2MatrixNodeBlock22_2
  norm_num [releasedLevel2Data22, ReleasedLevel2TermData.toTerm, Term.matrix,
    matrixStandard, entropyMu, rotate]
  all_goals simp at *
  all_goals ring


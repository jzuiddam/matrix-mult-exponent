noncomputable def releasedGlobalLambdaDirectRowsR1 : ℝ :=
  ∑ n : Fin 45, if OmegaBound.ADVXXZG1.rowLvl .X n = 0 ∨
      OmegaBound.ADVXXZG1.rowLvl .Y n = 0 then
    releasedLogicalAlphaYZ 1 n *
      Entropy.H Finset.univ (releasedLogicalBetaYZ 1 .Z n).probR else 0

noncomputable def releasedGlobalLambdaMixRowsR1 (a : Fin 9) : ℝ :=
  let mass := ∑ n : Fin 45,
    if 0 < OmegaBound.ADVXXZG1.rowLvl .X n ∧
        0 < OmegaBound.ADVXXZG1.rowLvl .Y n ∧
          OmegaBound.ADVXXZG1.rowLvl .Z n = a then
      releasedLogicalAlphaYZ 1 n else 0
  mass * Entropy.H Finset.univ
    (weightedSplit (releasedLogicalAlphaYZ 1) (releasedLogicalBetaYZ 1 .Z)
      (fun n => 0 < OmegaBound.ADVXXZG1.rowLvl .X n ∧
        0 < OmegaBound.ADVXXZG1.rowLvl .Y n ∧
          OmegaBound.ADVXXZG1.rowLvl .Z n = a))


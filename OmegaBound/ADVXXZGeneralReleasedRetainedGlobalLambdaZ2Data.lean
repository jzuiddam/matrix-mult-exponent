noncomputable def releasedGlobalLambdaDirectRowsR2 : ℝ :=
  ∑ n : Fin 45, if OmegaBound.ADVXXZG1.rowLvl .X n = 0 ∨
      OmegaBound.ADVXXZG1.rowLvl .Y n = 0 then
    releasedLogicalAlphaYZ 2 n *
      Entropy.H Finset.univ (releasedLogicalBetaYZ 2 .Z n).probR else 0

noncomputable def releasedGlobalLambdaMixRowsR2 (a : Fin 9) : ℝ :=
  let mass := ∑ n : Fin 45,
    if 0 < OmegaBound.ADVXXZG1.rowLvl .X n ∧
        0 < OmegaBound.ADVXXZG1.rowLvl .Y n ∧
          OmegaBound.ADVXXZG1.rowLvl .Z n = a then
      releasedLogicalAlphaYZ 2 n else 0
  mass * Entropy.H Finset.univ
    (weightedSplit (releasedLogicalAlphaYZ 2) (releasedLogicalBetaYZ 2 .Z)
      (fun n => 0 < OmegaBound.ADVXXZG1.rowLvl .X n ∧
        0 < OmegaBound.ADVXXZG1.rowLvl .Y n ∧
          OmegaBound.ADVXXZG1.rowLvl .Z n = a))


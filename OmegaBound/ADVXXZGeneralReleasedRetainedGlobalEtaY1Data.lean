noncomputable def releasedGlobalEtaDirectRowsR1 : ℝ :=
  ∑ n : Fin 45, if OmegaBound.ADVXXZG1.rowLvl .Z n = 0 then
    releasedLogicalAlphaYZ 1 n *
      Entropy.H Finset.univ (releasedLogicalBetaYZ 1 .Y n).probR else 0

noncomputable def releasedGlobalEtaMixRowsR1 (a : Fin 9) : ℝ :=
  let mass := ∑ n : Fin 45,
    if OmegaBound.ADVXXZG1.rowLvl .Y n = a ∧
        0 < OmegaBound.ADVXXZG1.rowLvl .Z n then
      releasedLogicalAlphaYZ 1 n else 0
  mass * Entropy.H Finset.univ
    (weightedSplit (releasedLogicalAlphaYZ 1) (releasedLogicalBetaYZ 1 .Y)
      (fun n => OmegaBound.ADVXXZG1.rowLvl .Y n = a ∧
        0 < OmegaBound.ADVXXZG1.rowLvl .Z n))


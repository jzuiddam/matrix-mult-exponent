noncomputable def releasedGlobalLambdaDirectRowsR3 : ℝ :=
  ∑ n : Fin 45, if OmegaBound.ADVXXZG1.rowLvl .X n = 0 ∨
      OmegaBound.ADVXXZG1.rowLvl .Y n = 0 then
    releasedLogicalAlphaYZ 3 n *
      Entropy.H Finset.univ (releasedLogicalBetaYZ 3 .Z n).probR else 0

noncomputable def releasedGlobalLambdaMixRowsR3 (a : Fin 9) : ℝ :=
  let mass := ∑ n : Fin 45,
    if 0 < OmegaBound.ADVXXZG1.rowLvl .X n ∧
        0 < OmegaBound.ADVXXZG1.rowLvl .Y n ∧
          OmegaBound.ADVXXZG1.rowLvl .Z n = a then
      releasedLogicalAlphaYZ 3 n else 0
  mass * Entropy.H Finset.univ
    (weightedSplit (releasedLogicalAlphaYZ 3) (releasedLogicalBetaYZ 3 .Z)
      (fun n => 0 < OmegaBound.ADVXXZG1.rowLvl .X n ∧
        0 < OmegaBound.ADVXXZG1.rowLvl .Y n ∧
          OmegaBound.ADVXXZG1.rowLvl .Z n = a))


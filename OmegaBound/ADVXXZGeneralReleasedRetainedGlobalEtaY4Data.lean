noncomputable def releasedGlobalEtaDirectRowsR4 : ℝ :=
  ∑ n : Fin 45, if OmegaBound.ADVXXZG1.rowLvl .Z n = 0 then
    releasedLogicalAlphaYZ 4 n *
      Entropy.H Finset.univ (releasedLogicalBetaYZ 4 .Y n).probR else 0

noncomputable def releasedGlobalEtaMixRowsR4 (a : Fin 9) : ℝ :=
  let mass := ∑ n : Fin 45,
    if OmegaBound.ADVXXZG1.rowLvl .Y n = a ∧
        0 < OmegaBound.ADVXXZG1.rowLvl .Z n then
      releasedLogicalAlphaYZ 4 n else 0
  mass * Entropy.H Finset.univ
    (weightedSplit (releasedLogicalAlphaYZ 4) (releasedLogicalBetaYZ 4 .Y)
      (fun n => OmegaBound.ADVXXZG1.rowLvl .Y n = a ∧
        0 < OmegaBound.ADVXXZG1.rowLvl .Z n))


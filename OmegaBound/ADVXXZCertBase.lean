  have : (0 : ℚ) < (certDen : ℚ) := by exact_mod_cast certDen_pos
  exact ne_of_gt this

/-- **The box bridge.**  A numerator inside its integer box gives a coordinate
inside its rational box.  Numerators are compared, never quotients. -/

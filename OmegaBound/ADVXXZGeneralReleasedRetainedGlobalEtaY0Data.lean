/-! Region-0 Y eta normalization, split into its direct boundary term and the nine
level-indexed weighted-mixture terms.  Each finite reduction is theorem-local. -/

noncomputable def releasedGlobalEtaDirectRowsR0 : ℝ :=
  ∑ n : Fin 45, if OmegaBound.ADVXXZG1.rowLvl .Z n = 0 then
    releasedLogicalAlphaYZ 0 n *
      Entropy.H Finset.univ (releasedLogicalBetaYZ 0 .Y n).probR else 0

noncomputable def releasedGlobalEtaMixRowsR0 (a : Fin (2 * 4 + 1)) : ℝ :=
  let mass := ∑ n : Fin 45,
    if OmegaBound.ADVXXZG1.rowLvl .Y n = a ∧
        0 < OmegaBound.ADVXXZG1.rowLvl .Z n then
      releasedLogicalAlphaYZ 0 n else 0
  mass * Entropy.H Finset.univ
    (weightedSplit (releasedLogicalAlphaYZ 0) (releasedLogicalBetaYZ 0 .Y)
      (fun n => OmegaBound.ADVXXZG1.rowLvl .Y n = a ∧
        0 < OmegaBound.ADVXXZG1.rowLvl .Z n))


    (∑ u : Shape 4, Real.exp (releasedGlobalFenchelLinearR2 u - 1)) =
      releasedGlobalFenchelExpR2 := by
  simp_rw [global_shape_sum_r2]
  simp_rw [released_global_fenchel_exponent_index_r2]
  rfl

set_option maxHeartbeats 2000000 in
theorem released_global_fenchel_exp_grouped_r2 :
    releasedGlobalFenchelExpR2 = releasedGlobalFenchelExpGroupedR2 := by
  unfold releasedGlobalFenchelExpR2
  simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero]
  simp only [releasedGlobalFenchelExponentR2, Matrix.cons_val_zero,
    Matrix.cons_val_succ, Matrix.cons_val_one, Matrix.head_cons, Matrix.tail_cons,
    Matrix.cons_val_two, Matrix.cons_val_fin_one]
  unfold releasedGlobalFenchelExpGroupedR2
  simp only [one_mul]
  abel

set_option maxHeartbeats 2000000 in
theorem released_global_linear_expectation_r2 :
    (∑ u : Shape 4, physicalGlobalSpec.toPaper.alpha 2 u *
      releasedGlobalFenchelLinearR2 u) =
      releasedGlobalLinearExpectationR2 := by
  simp_rw [global_shape_sum_r2]
  simp_rw [released_global_fenchel_linear_product_index_r2]
  exact released_global_fenchel_linear_product_sum_r2

theorem released_global_maximum_entropy_r2 :
    globalFenchelUpper (physicalGlobalSpec.toPaper.alpha 2)
        releasedGlobalFenchelLinearR2 =
      releasedGlobalMaximumEntropyR2 := by
  unfold globalFenchelUpper releasedGlobalMaximumEntropyR2
  rw [released_global_fenchel_exp_r2,
    released_global_linear_expectation_r2]

set_option maxHeartbeats 2000000 in
theorem released_global_x_dual_eq_r2 :
    OmegaBound.ADVXXZCert.actualRetainedCapacity_10_1 =
      (1 : ℝ) / 6 *
        (Entropy.H Finset.univ
            (marginal (physicalGlobalSpec.toPaper.alpha 2)
              (physicalGlobalSpec.toPaper.perm 2 .X)) +
          Entropy.H Finset.univ (physicalGlobalSpec.toPaper.alpha 2) -
          globalFenchelUpper (physicalGlobalSpec.toPaper.alpha 2)
            (globalFenchelLinear releasedGlobalLambdaSumR2
              releasedGlobalLambdaMarginR2)) := by
  change OmegaBound.ADVXXZCert.actualRetainedCapacity_10_1 =
    (1 : ℝ) / 6 *
      (Entropy.H Finset.univ
          (marginal (physicalGlobalSpec.toPaper.alpha 2)
            (physicalGlobalSpec.toPaper.perm 2 .X)) +
        Entropy.H Finset.univ (physicalGlobalSpec.toPaper.alpha 2) -
        globalFenchelUpper (physicalGlobalSpec.toPaper.alpha 2)
          releasedGlobalFenchelLinearR2)
  rw [released_global_marginal_entropy_x_r2,
    released_global_alpha_entropy_r2, released_global_maximum_entropy_r2]
  unfold releasedGlobalMaximumEntropyR2
  rw [released_global_fenchel_exp_grouped_r2]
  unfold OmegaBound.ADVXXZCert.actualRetainedCapacity_10_1 OmegaBound.ADVXXZCert.retainedRow_10_1_00
    releasedGlobalMarginalEntropyXR2 releasedGlobalAlphaEntropyR2
    releasedGlobalFenchelExpGroupedR2
    releasedGlobalLinearExpectationR2
  ring

end OmegaBound.ADVXXZGeneral


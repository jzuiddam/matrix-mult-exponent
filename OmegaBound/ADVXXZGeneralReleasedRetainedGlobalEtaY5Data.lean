noncomputable def releasedGlobalEtaDirectRowsR5 : ℝ :=
  ∑ n : Fin 45, if OmegaBound.ADVXXZG1.rowLvl .Z n = 0 then
    releasedLogicalAlphaYZ 5 n *
      Entropy.H Finset.univ (releasedLogicalBetaYZ 5 .Y n).probR else 0

noncomputable def releasedGlobalEtaMixRowsR5 (a : Fin 9) : ℝ :=
  let mass := ∑ n : Fin 45,
    if OmegaBound.ADVXXZG1.rowLvl .Y n = a ∧
        0 < OmegaBound.ADVXXZG1.rowLvl .Z n then
      releasedLogicalAlphaYZ 5 n else 0
  mass * Entropy.H Finset.univ
    (weightedSplit (releasedLogicalAlphaYZ 5) (releasedLogicalBetaYZ 5 .Y)
      (fun n => OmegaBound.ADVXXZG1.rowLvl .Y n = a ∧
        0 < OmegaBound.ADVXXZG1.rowLvl .Z n))

